{
  "name": "echostream-node",
  "version": "0.1.0",
  "description": "EchoStream Node.js binding — 基于 QUIC 的双向 RPC / Event / Stream 实时通信框架（自动编解码）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postcard": {
      "types": "./dist/postcard.d.ts",
      "default": "./dist/postcard.js"
    }
  },
  "license": "MIT",
  "keywords": [
    "rpc",
    "quic",
    "streaming",
    "realtime",
    "websocket"
  ],
  "files": [
    "dist",
    "echostream-node.node",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node dist/test/codec.test.js && node dist/test/server.test.js",
    "test:cross": "node dist/test/cross_client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
